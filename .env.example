# --- Required ---
DATABASE_URL=postgresql+asyncpg://trip:CHANGE_ME@trip-tracker-db:5432/trip
SESSION_SECRET=  # generate: python -c 'import secrets; print(secrets.token_hex(32))'

OIDC_ISSUER=https://auth.yourdomain.com
OIDC_CLIENT_ID=trip-tracker
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://trips.yourdomain.com/auth/callback
BASE_URL=https://trips.yourdomain.com

# --- Postgres init ---
DB_PASSWORD=CHANGE_ME

# --- Optional ---
ADMIN_GROUP=trip-tracker:admin
LOG_LEVEL=INFO
LOG_FORMAT=json
TZ=America/Los_Angeles

# --- Webhook (forwardemail.net) ---
WEBHOOK_SECRET=  # generate: python -c 'import secrets; print(secrets.token_hex(32))'
# Header name forwardemail.net signs with — confirm at config time, override only if needed:
# WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature
# WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
# WEBHOOK_MAX_BODY_BYTES=26214400

# --- Phase 3: parser pipeline ---
ANTHROPIC_API_KEY=sk-ant-...           # Haiku LLM fallback
REDIS_URL=redis://trip-tracker-redis:6379/0
# Optional (defaults shown):
# LLM_DAILY_BUDGET_CENTS=100           # $1.00 USD/day soft cap
# LLM_MODEL=claude-haiku-4-5-20251001  # pinned per master spec
# LLM_CONFIDENCE_FLOOR=0.7             # below = parse_status='review'
