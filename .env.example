# --- Required ---
DATABASE_URL=postgresql+asyncpg://trip:CHANGE_ME@trip-tracker-db:5432/trip
SESSION_SECRET=  # generate: python -c 'import secrets; print(secrets.token_hex(32))'

OIDC_ISSUER=https://auth.yourdomain.com
