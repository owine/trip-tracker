# --- Postgres init ---
DB_PASSWORD=CHANGE_ME

# --- Optional ---
ADMIN_GROUP=trip-tracker:admin
LOG_LEVEL=INFO
LOG_FORMAT=json
TZ=America/Los_Angeles
