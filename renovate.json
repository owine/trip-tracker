{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>owine/renovate-config",
    "github>owine/renovate-config:automerge",
    "github>owine/renovate-config:python",
    "github>owine/renovate-config:docker"
  ],
  "packageRules": [
    {
      "description": "uv image ships frequently and is trusted — bundle into the shared dockerfile bases group",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["ghcr.io/astral-sh/uv"],
      "groupName": "dockerfile bases"
    },
    {
      "description": "Hatchling build tooling",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["hatchling"],
      "groupName": "build tooling"
    }
  ],
  "customManagers": [
    {
      "description": "Track standalone Tailwind CLI version pinned in scripts/build-tailwind.sh",
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/build-tailwind\\.sh$/"
      ],
      "matchStrings": ["VERSION=\"(?<currentValue>v[0-9.]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "tailwindlabs/tailwindcss",
      "extractVersionTemplate": "^(?<version>v.+)$"
    }
  ]
}
